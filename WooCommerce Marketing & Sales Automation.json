    {
      "parameters": {
        "sendTo": "={{$vars.ADMIN_EMAIL}}",
        "subject": "=سفارش جدید شماره {{ $json['شماره سفارش'] }}",
        "message": "=<div dir=\"rtl\" style=\"font-family: Tahoma, Arial, sans-serif; max-width: 550px; margin: 0 auto; border: 1px solid #e0e0e0; border-radius: 12px; overflow: hidden; background-color: #ffffff; box-shadow: 0 4px 10px rgba(0,0,0,0.05);\">\n  \n  <!-- Header -->\n  <div style=\"background-color: #2563eb; color: #ffffff; padding: 20px; text-align: center;\">\n    <h2 style=\"margin: 0; font-size: 20px; font-weight: bold;\">🛒 ثبت سفارش جدید در وب‌سایت</h2>\n  </div>\n\n  <!-- Body -->\n  <div style=\"padding: 24px; color: #333333; line-height: 1.6;\">\n    <p style=\"font-size: 15px; margin-top: 0;\">سلام مدیر محترم، یک سفارش جدید در سیستم ثبت شد:</p>\n    \n    <table style=\"width: 100%; border-collapse: collapse; margin-top: 15px; font-size: 14px;\">\n      <tr style=\"border-bottom: 1px solid #f0f0f0;\">\n        <td style=\"padding: 10px 0; color: #666666; font-weight: bold;\">شماره سفارش:</td>\n        <td style=\"padding: 10px 0; text-align: left; font-weight: bold; color: #2563eb;\">#{{ $json[\"شماره سفارش\"] }}</td>\n      </tr>\n      <tr style=\"border-bottom: 1px solid #f0f0f0;\">\n        <td style=\"padding: 10px 0; color: #666666;\">نام خریدار:</td>\n        <td style=\"padding: 10px 0; text-align: left;\">{{ $json[\"نام مشتری\"] }}</td>\n      </tr>\n      <tr style=\"border-bottom: 1px solid #f0f0f0;\">\n        <td style=\"padding: 10px 0; color: #666666;\">ایمیل:</td>\n        <td style=\"padding: 10px 0; text-align: left; dir: ltr;\">{{ $json[\"ایمیل مشتری\"] }}</td>\n      </tr>\n      <tr style=\"border-bottom: 1px solid #f0f0f0;\">\n        <td style=\"padding: 10px 0; color: #666666;\">مبلغ کل:</td>\n        <td style=\"padding: 10px 0; text-align: left; font-weight: bold; color: #16a34a;\">{{ $json[\"مبلغ کل\"] }} {{ $json[\"واحد پول\"] }}</td>\n      </tr>\n      <tr style=\"border-bottom: 1px solid #f0f0f0;\">\n        <td style=\"padding: 10px 0; color: #666666;\">تاریخ و زمان ثبت:</td>\n        <td style=\"padding: 10px 0;