      "parameters": {
        "jsCode": "const items = $input.all();\n\nlet totalSales = 0;\nlet orderCount = items.length;\n\n// روش ایمن برای استخراج و جمع زدن قیمت‌ها\nitems.forEach(item => {\n  const rawTotal = item.json.total;\n  const numericTotal = typeof rawTotal === 'number' \n    ? rawTotal \n    : parseFloat(String(rawTotal || '0').replace(/[^0-9.-]+/g, '')) || 0;\n  \n  totalSales += numericTotal;\n});\n\nconst averageOrderValue = orderCount > 0 ? Math.round(totalSales / orderCount) : 0;\n\n// تبدیل استاندراد و دقیق تاریخ میلادی به شمسی بدون نیاز به توابع دستی\nfunction getPersianDateString() {\n  const now = new Date();\n  const formatter = new Intl.DateTimeFormat('fa-IR-u-nu-latn', {\n    year: 'numeric',\n    month: '2-digit',\n    day: '2-digit',\n    timeZone: 'Asia/Tehran'\n  });\n  return formatter.format(now); // خروجی استاندارد: YYYY/MM/DD\n}\n\nconst persianDate = getPersianDateString();\n\n// فرمت‌دهی ایمن اعداد به فارسی\nconst formattedOrderCount = (orderCount || 0).toLocaleString('fa-IR');\nconst formattedTotalSales = (totalSales || 0).toLocaleString('fa-IR');\nconst formattedAOV = (averageOrderValue || 0).toLocaleString('fa-IR');\n\nconst htmlReport = `\n<div style=\"font-family: Tahoma, Arial, sans-serif; direction: rtl; text-align: right; background-color: #f8f9fa; padding: 20px; border-radius: 10px; color: #333; max-width: 500px; margin: auto; border: 1px solid #e9ecef;\">\n  <h2 style=\"color: #2c3e50; border-bottom: 2px solid #4bc0c0; padding-bottom: 10px; margin-top: 0; font-size: 18px;\">\n    📊 گزارش فروش ۷ روز گذشته (${persianDate})\n  </h2>\n  \n  <table style=\"width: 100%; border-collapse: collapse; margin-top: 15px;\">\n    <tr style=\"border-bottom: 1px solid #dee2e6;\">\n      <td style=\"padding: 10px 0; color: #555;\">🛒 تعداد سفارشات:</td>\n      <td style=\"padding: 10px 0; font-weight: bold; text-align: left; color: #2c3e50;\">${formattedOrderCount} عدد</td>\n    </tr>\n    <tr style=\"border-bottom: 1px solid #dee2e6;\">\n      <td style=\"padding: 10px 0; color: #555;\">💰 مجموع فروش:</td>\n      <td style=\"padding: 10px 0; font-weight: bold; text-align: left; color: #27ae60;\">${formattedTotalSales} تومان</td>\n    </tr>\n    <tr>\n      <td style=\"padding: 10px 0; color: #555;\">📈 میانگین ارزش هر سفارش:</td>\n      <td style=\"padding: 10px 0; font-weight: bold; text-align: left; color: #2980b9;\">${formattedAOV} تومان</td>\n    </tr>\n  </table>\n  \n  <div style=\"margin-top: 20px; font-size: 11px; color: #888; text-align: center;\">\n    گزارش به‌صورت خودکار توسط سیستم اتوماسیون n8n تولید شده است.\n  </div>\n</div>\n`;\n\nreturn {\n  json: {\n    orderCount,\n    totalSales,\n    averageOrderValue,\n    persianDate,\n    htmlReport\n  }\n};"
      },
