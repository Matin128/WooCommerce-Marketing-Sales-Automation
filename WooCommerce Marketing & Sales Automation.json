    {
      "parameters": {
        "jsCode": "const all = $input.all().map((i) => i.json);\n\n// ۱. جدا کردن کاربران\nconst users = all\n  .filter((r) => r.recordType === 'email' || r.email)\n  .map((r) => ({\n    email: String(r.email || '').trim().toLowerCase(),\n    firstName: r.firstName || 'کاربر عزیز',\n    interest: (r.interest || '').trim()\n  }))\n  .filter((u) => u.email && u.interest);\n\n// ۲. جدا کردن محصولات (حذف آیتم‌های صوری no_product)\nconst products = all.filter((r) => r.recordType === 'product' && r.productId);\n\n// اگر محصول جدید یا کاربری وجود نداشت، فرآیند را بدون خطا تمام کن\nif (products.length === 0 || users.length === 0) {\n  return [];\n}\n\n// یکسان‌سازی کاربران (حذف ایمیل‌های تکراری)\nconst seen = new Set();\nconst uniqueUsers = users.filter((u) => {\n  if (seen.has(u.email)) return false;\n  seen.add(u.email);\n  return true;\n});\n\nconst categoryMap = {\n  'رمان جنایی': ['رمان جنایی', 'جنایی', 'جرم', 'کارآگاهی'],\n  'رمان فانتزی': ['رمان فانتزی', 'فانتزی', 'خیالی', 'تخیلی'],\n  'رمان ادبیاتی': ['رمان ادبیاتی', 'ادبیاتی', 'ادبی', 'کلاسیک']\n};\n\nfunction findMatchingCategory(userInterest) {\n  const interest = userInterest.trim().toLowerCase();\n  for (const [mainCategory, keywords] of Object.entries(categoryMap)) {\n    for (const keyword of keywords) {\n      if (interest.includes(keyword) || keyword.includes(interest)) {\n        return mainCategory;\n      }\n    }\n  }\n  return null;\n}\n\nconst finalOutput = [];\n\nfor (const user of uniqueUsers) {\n  const matchedCategory = findMatchingCategory(user.interest);\n  if (!matchedCategory) continue;\n\n  const matchedProducts = products.filter((p) => {\n    return Array.isArray(p.categories) && \n           p.categories.some(cat => cat.trim() === matchedCategory);\n  });\n\n  if (matchedProducts.length === 0) continue;\n\n  finalOutput.push({\n    json: {\n      email: user.email,\n      firstName: user.firstName,\n      interest: user.interest,\n      matchedCategory: matchedCategory,\n      products: matchedProducts,\n      productCount: matchedProducts.length,\n    }\n  });\n}\n\nreturn finalOutput;"
      },
