    {
      "parameters": {
        "jsCode": "const items = $input.all();\nconst output = [];\n\nfor (const item of items) {\n  const p = item.json;\n  if (!p || !p.id) continue;\n\n  const price = parseFloat(p.price ?? p.regular_price ?? '0') || 0;\n  const image = Array.isArray(p.images) && p.images.length > 0 ? p.images[0].src : '';\n  const categories = Array.isArray(p.categories) ? p.categories.map(c => c.name.trim()) : [];\n\n  output.push({\n    json: {\n      recordType: 'product',\n      productId: p.id,\n      name: (p.name || '').trim(),\n      price: price,\n      priceFormatted: `$${price.toFixed(2)}`,\n      permalink: p.permalink || '',\n      image: image,\n      categories: categories,\n      dateCreated: p.date_created || null,\n    },\n  });\n}\n\nconst oneDayAgo = new Date();\noneDayAgo.setDate(oneDayAgo.getDate() - 1);\n\nconst recentOnly = output.filter((o) => {\n  if (!o.json.dateCreated) return false;\n  return new Date(o.json.dateCreated) >= oneDayAgo;\n});\n\n// اگر محصول جدیدی وجود نداشت، یک آیتم توخالی بفرست تا Merge متوقف نشود\nif (recentOnly.length === 0) {\n  return [{ json: { recordType: 'no_product' } }];\n}\n\nreturn recentOnly;"
      },
