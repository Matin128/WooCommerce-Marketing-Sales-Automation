      "parameters": {
        "jsCode": "const items = $input.all();\n\nconst validItems = items.filter(item => {\n  const row = item.json;\n  \n  // بررسی وجود ایمیل و فرمت معتبر\n  const email = row['ایمیل'] || row['email'] || '';\n  const emailPattern = /^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/;\n  const isValidEmail = emailPattern.test(email.trim());\n  \n  // بررسی وجود علاقه‌مندی\n  const interest = row['علاقه مندی'] || row['interest'] || '';\n  const isValidInterest = interest.trim().length > 0;\n  \n  // فقط ردیف‌هایی که هر دو شرط رو دارن، برگردون\n  return isValidEmail && isValidInterest;\n});\n\nreturn validItems;"
      },
