      "parameters": {
        "jsCode": "const items = $input.all();\n\nif (items.length === 0) {\n  return [];\n}\n\nreturn items.map((item) => {\n  const p = item.json;\n  \n  // بررسی اولویت قیمت فروش ویژه، قیمت عمومی و قیمت عادی\n  let rawPrice = '0';\n  if (p.sale_price && p.sale_price !== '0') {\n    rawPrice = p.sale_price;\n  } else if (p.price && p.price !== '0') {\n    rawPrice = p.price;\n  } else if (p.regular_price) {\n    rawPrice = p.regular_price;\n  }\n\n  const price = parseFloat(rawPrice) || 0;\n\n  return {\n    json: {\n      \"شناسه محصول\": p.id,\n      \"نام محصول\": (p.name || '').trim(),\n      \"قیمت\": price,\n    },\n  };\n});"
      },
