    {
      "parameters": {
        "jsCode": "const items = $input.all();\nconst output = [];\n\nfunction escapeHtml(str = '') {\n  return String(str)\n    .replace(/&/g, '&amp;')\n    .replace(/</g, '&lt;')\n    .replace(/>/g, '&gt;');\n}\n\nfunction formatToman(price) {\n  if (!price || price === 0) return 'رایگان / تماس بگیرید';\n  return new Intl.NumberFormat('fa-IR').format(price) + ' تومان';\n}\n\nfunction renderProductCard(p) {\n  return `\n    <table style=\"width:100%;margin-bottom:16px;border:1px solid #eee;border-radius:8px;direction:rtl;text-align:right;background:#ffffff;\">\n      <tr>\n        <td style=\"width:120px;padding:8px;\">\n          ${p.image ? `<img src=\"${p.image}\" width=\"100\" style=\"border-radius:6px;display:block;\" />` : ''}\n        </td>\n        <td style=\"padding:12px;vertical-align:top;\">\n          <div style=\"font-weight:bold;font-size:15px;color:#333;margin-bottom:6px;\">${escapeHtml(p.name)}</div>\n          <div style=\"color:#2e7d32;font-weight:bold;margin:6px 0;\">${formatToman(p.price)}</div>\n          <a href=\"${p.permalink}\" style=\"display:inline-block;margin-top:6px;color:#0277bd;text-decoration:none;font-size:13px;font-weight:bold;\">مشاهده و خرید کتاب &larr;</a>\n        </td>\n      </tr>\n    </table>`;\n}\n\nfor (const item of items) {\n  const j = item.json;\n  const products = j.products || [];\n  const productCards = products.map(renderProductCard).join('\\n');\n  const interest = j.interest || 'مورد علاقه شما';\n\n  const htmlBody = `\n    <div style=\"font-family:Tahoma,Arial,sans-serif;max-width:600px;margin:0 auto;direction:rtl;text-align:right;padding:20px;background:#f9f9f9;border-radius:10px;\">\n      <h2 style=\"color:#222;font-size:18px;\">سلام ${escapeHtml(j.firstName || 'مخاطب عزیز')} جان، جدیدترین کتاب‌های دسته «${escapeHtml(interest)}» رسید!</h2>\n      <p style=\"color:#555;font-size:14px;line-height:1.6;\">\n        با توجه به علاقه‌مندی شما به کتاب‌های <b>${escapeHtml(interest)}</b>، به‌تازگی ${products.length} عنوان جدید به فروشگاه اضافه شده که پیشنهاد می‌کنیم نگاهی به آن‌ها بیندازید:\n      </p>\n      <br />\n      ${productCards}\n      <p style=\"color:#888;font-size:11px;margin-top:24px;border-top:1px solid #ddd;padding-top:12px;text-align:center;\">\n        این ایمیل بر اساس علاقه‌مندی‌های ثبت‌شده شما در خبرنامه اختصاصی ارسال شده است.\n      </p>\n    </div>`;\n\n  output.push({\n    json: {\n      to: j.email,\n      subject: `📚 ${j.firstName || 'کاربر'} عزیز، جدیدترین کتاب‌های ${interest} منتظر شماست!`,\n      htmlBody,\n    },\n  });\n}\n\nreturn output;"
      },
